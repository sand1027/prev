<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sandeep.leetcode-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/sandeepv/Desktop/prev/leetcode-bot/run-if-due.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TARGET_HOUR</key>
    <string>8</string>
    <key>TARGET_MIN</key>
    <string>0</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Try at 8:00 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Catch-up every 10 min if Mac woke late / cron missed -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/lc-bot-launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lc-bot-launchd.err</string>
</dict>
</plist>
